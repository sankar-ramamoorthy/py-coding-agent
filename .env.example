# .env.example
LLM_PROVIDER=ollama-auto
# LLM_PROVIDER=ollama-remote
# LLM_PROVIDER=ollama-local
# LLM_PROVIDER=ollama
# LLM_PROVIDER=litellm

# Ollama dual-backend (used by ollama-auto/ollama-remote/ollama-local)
# OLLAMA_REMOTE_URL=http://100.105.24.12:11434
# OLLAMA_REMOTE_MODEL=qwen3.5:4b
# OLLAMA_LOCAL_URL=http://host.docker.internal:11434
# OLLAMA_LOCAL_MODEL=Qwen3:4b

# LITELLM_MODEL=groq/qwen/qwen3-32b
# GROQ_API_KEY=your-groq-key-here
# LLM_MASTER_KEY=your-generated-fernet-key-here

# Shell tool - disabled by default. Not a content sandbox even when enabled;
# only enable in a trusted environment.
# ENABLE_SHELL_TOOL=true

# Extra directories file tools may access beyond the workspace. Empty by
# default. Comma-separated absolute paths, e.g.:
# ADDITIONAL_ALLOWED_PATHS=/some/other/dir,/another/dir